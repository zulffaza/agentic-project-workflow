# OS / filesystem cruft (macOS)
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# JetBrains IDEs (repo lives under ~/IdeaProjects)
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code + Cursor (Kilo / agent sessions)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
.cursor/

# Editors / shell leftovers
*.swp
*.swo
.*.swp
*~
\#*\#
.\#*
Session.vim
.netrwhist
.~lock.*#

# Generic temp/backup (only dot-namespaced or clearly scratch — never bare
# bin/, lib/, tmp/, temp/, tags, *.log, *.zip, *.png etc: those patterns
# silently swallow real files under tooling/scripts/ and friends)
.cache/
*.tmp
*.bak

# machine-generated by bootstrap.sh
pw-env.sh

# your local config (created from pw.config.example.sh)
pw.config.sh
