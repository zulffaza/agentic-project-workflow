#!/usr/bin/env bash
# Fake `glab` for offline tests — see pw_test_lib.sh. Records invocations to $PWTEST_FORGE_LOG
# so "which iid won" is assertable; state comes from $PWTEST_FORGE_STATE_FILE ("<iid> <state>"
# lines, GitLab vocabulary opened/merged/closed). Unknown shapes exit 42 loudly (coupling
# alarm). NEVER touches the network.
set -u
[ -n "${PWTEST_FORGE_LOG:-}" ] && printf '%s %s\n' "glab $*" >>"$PWTEST_FORGE_LOG"
if [ -n "${PWTEST_FORGE_FAIL:-}" ]; then echo "glab-shim: forced query failure" >&2; exit 1; fi
if [ -n "${PWTEST_HISTORY_FORGE_DIR:-}" ] && { [ "${1:-}" = api ] || { [ "${1:-}" = mr ] && [ "${2:-}" = create ]; }; }; then
  exec python3 "$(dirname "$0")/forge-history.py" glab "$@"
fi
if [ -n "${PWTEST_REVIEW_FORGE_DIR:-}" ] && [ "${1:-}" = api ]; then
  exec python3 "$(dirname "$0")/forge-review.py" glab "$@"
fi
_draft_of() {  # <iid> -> draft|ready|""
  local k="$1" v=""
  [ -n "${PWTEST_FORGE_STATE_FILE:-}" ] && [ -f "$PWTEST_FORGE_STATE_FILE" ] && \
    v="$(awk -v k="$k" '$1==k{print $3; exit}' "$PWTEST_FORGE_STATE_FILE")"
  printf '%s' "$v"
}
_draft_json() { [ "$(_draft_of "$1")" = draft ] && printf true || printf false; }
_title_of() {
  local k="$1" t=""
  [ -n "${PWTEST_MR_TITLE_FILE:-}" ] && [ -f "$PWTEST_MR_TITLE_FILE" ] && \
    t="$(awk -v k="$k" '$1==k{sub($1" ",""); print; exit}' "$PWTEST_MR_TITLE_FILE")"
  printf '%s' "${t:-Fixture MR}"
}
_state_json() {
  local iid="$1" st="opened" tgt="${PWTEST_MR_TARGET:-master}" t hd="dead000f" h
  if [ -n "${PWTEST_FORGE_STATE_FILE:-}" ] && [ -f "$PWTEST_FORGE_STATE_FILE" ]; then
    st="$(awk -v k="$iid" '$1==k{print $2; exit}' "$PWTEST_FORGE_STATE_FILE")"; st="${st:-opened}"
  fi
  # Per-MR target map (stack tests): "<iid> <target>" lines override the single default.
  if [ -n "${PWTEST_MR_TARGETS_FILE:-}" ] && [ -f "$PWTEST_MR_TARGETS_FILE" ]; then
    t="$(awk -v k="$iid" '$1==k{print $2; exit}' "$PWTEST_MR_TARGETS_FILE")"; [ -n "$t" ] && tgt="$t"
  fi
  # Per-MR head map (head-move guard tests): "<iid> <sha>" lines override dead000f.
  if [ -n "${PWTEST_MR_HEAD_FILE:-}" ] && [ -f "$PWTEST_MR_HEAD_FILE" ]; then
    h="$(awk -v k="$iid" '$1==k{print $2; exit}' "$PWTEST_MR_HEAD_FILE")"; [ -n "$h" ] && hd="$h"
  fi
  # A real forge may pretty-print its JSON; PWTEST_MR_PRETTY=1 pins that shape so a
  # whitespace-sensitive reader cannot pass by accident. Falls back to compact without jq.
  if [ -n "${PWTEST_MR_PRETTY:-}" ] && command -v jq >/dev/null 2>&1; then
    printf '{"iid":"%s","state":"%s","sha":"%s","target_branch":"%s","draft":%s,"title":"%s","web_url":"https://gitlab.example.com/pwtest/api/-/merge_requests/%s"}\n' "$iid" "$st" "$hd" "$tgt" "$(_draft_json "$iid")" "$(_title_of "$iid")" "$iid" | jq .
  else
    printf '{"iid":"%s","state":"%s","sha":"%s","target_branch":"%s","draft":%s,"title":"%s","web_url":"https://gitlab.example.com/pwtest/api/-/merge_requests/%s"}\n' "$iid" "$st" "$hd" "$tgt" "$(_draft_json "$iid")" "$(_title_of "$iid")" "$iid"
  fi
}
_list_json() {
  # Seeded existing-MR lookup: PWTEST_MR_LIST_FILE lines "<source-branch> <url>".
  local f="${PWTEST_MR_LIST_FILE:-}" b u first=1
  printf '['
  if [ -n "$f" ] && [ -f "$f" ]; then
    while read -r b u; do
      [ -n "$b" ] || continue
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"web_url":"%s","source_branch":"%s"}' "$u" "$b"
    done < "$f"
  fi
  printf ']\n'
}
case "${1:-}" in
  mr)
    if [ "${2:-}" = create ] && { [ "${3:-}" = --help ] || [ "${3:-}" = -h ]; }; then
      echo "Create a new merge request."
      echo "  -s, --source-branch string   Source branch"
      echo "  -b, --target-branch string   Target branch"
      echo "  -t, --title string           Title"
      echo "  -d, --description string     Description"
      [ -n "${PWTEST_GLAB_CREATE_NO_DRAFT:-}" ] || echo "      --draft                  Mark the merge request as a draft"
      if [ -z "${PWTEST_GLAB_CREATE_NO_OUTPUT:-}" ]; then
        echo "  -F, --output string          Format output as: text, json"
      fi
      exit 0
    fi
    case "${2:-}" in
      view) _iid="$(printf %s "${3:-}" | awk -F/ "{print \$NF}" | tr -dc 0-9)"; _state_json "${_iid:-${3:-0}}" ;;
      create)
              # A release without the JSON contract must REJECT the flag: a shim that ignores it
              # can never prove the capability check works.
              if [ -n "${PWTEST_GLAB_CREATE_NO_OUTPUT:-}" ]; then
                for _a in "$@"; do case "$_a" in --output|-F|--output=*) echo "glab-shim: unknown flag: $_a" >&2; exit 42 ;; esac; done
              fi
              if [ -n "${PWTEST_FORGE_CREATE+set}" ] && [ -z "$PWTEST_FORGE_CREATE" ]; then
                echo "glab-shim: creation returned no URL (forced)" >&2; exit 1; fi
              n=$(( $(wc -l < "${PWTEST_FORGE_STATE_FILE:-/dev/null}" 2>/dev/null || echo 0) + 42 ))
              _d=""; _title=""
              _prev=""
              for _a in "$@"; do
                [ "$_prev" = "--title" ] && _title="$_a"
                [ "$_prev" = "--draft" ] && _d=draft
                _prev="$_a"
                [ "$_a" = "--draft" ] && _d=draft
              done
              case " $* " in *" --draft "*) _d=draft ;; esac
              if [ -n "${PWTEST_FORGE_STATE_FILE:-}" ]; then
                printf '%s opened %s\n' "$n" "$_d" >> "$PWTEST_FORGE_STATE_FILE"
              fi
              if [ -n "$_title" ] && [ -n "${PWTEST_MR_TITLE_FILE:-}" ]; then
                printf '%s %s\n' "$n" "$_title" >> "$PWTEST_MR_TITLE_FILE"
              fi
              case " $* " in
                *" --output json "*) _state_json "$n" ;;
                *) printf 'Creating merge request...\nhttps://gitlab.example.com/pwtest/api/-/merge_requests/%s\n' "$n" ;;
              esac ;;
      update) _iid="$(printf %s "${3:-}" | awk -F/ "{print \$NF}" | tr -dc 0-9)"
              _tb=""; _prev=""
              for _a in "$@"; do [ "$_prev" = "--target-branch" ] && _tb="$_a"; _prev="$_a"; done
              if [ -n "$_tb" ] && [ -n "${PWTEST_MR_TARGETS_FILE:-}" ]; then
                awk -v k="$_iid" -v b="$_tb" 'BEGIN{done=0} $1==k{print k" "b; done=1; next} {print} END{if(!done) print k" "b}' \
                  "$PWTEST_MR_TARGETS_FILE" > "$PWTEST_MR_TARGETS_FILE.tmp" 2>/dev/null && mv "$PWTEST_MR_TARGETS_FILE.tmp" "$PWTEST_MR_TARGETS_FILE"
              fi
              # Race injection: an external change lands right AFTER our write (readback must catch it).
              if [ -n "${PWTEST_MR_SABOTAGE_TARGET:-}" ] && [ -n "${PWTEST_MR_TARGETS_FILE:-}" ] && [ -f "$PWTEST_MR_TARGETS_FILE" ]; then
                awk -v k="$_iid" -v b="$PWTEST_MR_SABOTAGE_TARGET" 'BEGIN{done=0} $1==k{print k" "b; done=1; next} {print} END{if(!done) print k" "b}' \
                  "$PWTEST_MR_TARGETS_FILE" > "$PWTEST_MR_TARGETS_FILE.tmp" 2>/dev/null && mv "$PWTEST_MR_TARGETS_FILE.tmp" "$PWTEST_MR_TARGETS_FILE"
              fi
              # Head-move injection: an external PUSH races the retarget (readback must see it).
              if [ -n "${PWTEST_MR_HEAD_SABOTAGE:-}" ] && [ -n "${PWTEST_MR_HEAD_FILE:-}" ]; then
                awk -v k="$_iid" -v b="$PWTEST_MR_HEAD_SABOTAGE" 'BEGIN{done=0} $1==k{print k" "b; done=1; next} {print} END{if(!done) print k" "b}' \
                  "$PWTEST_MR_HEAD_FILE" > "$PWTEST_MR_HEAD_FILE.tmp" 2>/dev/null && mv "$PWTEST_MR_HEAD_FILE.tmp" "$PWTEST_MR_HEAD_FILE"
              fi
              _state_json "${_iid:-${3:-0}}" ;;
      *) printf 'glab-shim: unexpected mr sub: %s\n' "$2" >&2; exit 42 ;;
    esac ;;
  api)
    case " $* " in
      *" --method PUT "*)
        _iid="${2##*/}"; _payload="$(cat)"
        python3 - "$_iid" "$_payload" "${PWTEST_FORGE_STATE_FILE:-/dev/null}" "${PWTEST_MR_TITLE_FILE:-/dev/null}" <<'PYG'
import json, re, sys
iid, payload, state_file, title_file = sys.argv[1:5]
data = json.loads(payload or '{}')
title = data.get('title') if isinstance(data.get('title'), str) else None
draft = 'draft' if title is not None and re.match(r'^(draft|wip)\s*:', title, re.I) else ('ready' if title is not None else '')
try:
    lines = open(state_file).read().splitlines()
except OSError:
    lines = []
out, found = [], False
for line in lines:
    parts = line.split()
    if parts and parts[0] == iid:
        st = parts[1] if len(parts) > 1 else 'opened'
        mark = draft if draft else (parts[2] if len(parts) > 2 else '')
        out.append(' '.join([iid, st, mark]).strip()); found = True
    else:
        out.append(line)
if not found:
    out.append(' '.join([iid, 'opened', draft]).strip())
open(state_file, 'w').write('\n'.join(out) + '\n')
if title is not None:
    try:
        tl = open(title_file).read().splitlines()
    except OSError:
        tl = []
    tout, tfound = [], False
    for line in tl:
        if line.split(' ', 1)[0] == iid:
            tout.append(iid + ' ' + title); tfound = True
        else:
            tout.append(line)
    if not tfound:
        tout.append(iid + ' ' + title)
    open(title_file, 'w').write('\n'.join(tout) + '\n')
PYG
        _state_json "$_iid"; exit 0 ;;
    esac
    case "${2:-}" in
      *'merge_requests?'*) _list_json ;;
      *pipelines*) printf '%s\n' "${PWTEST_PIPELINE:-}"; exit 0 ;;
      *merge_requests*) _state_json "${2##*/}" ;;
      *) printf '{}\n' ;;
    esac ;;
  auth) exit 0 ;;
  *) printf 'glab-shim: unexpected invocation: %s\n' "$*" >&2; exit 42 ;;
esac
